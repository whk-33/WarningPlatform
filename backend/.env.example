# 复制为 .env 后按需修改（本项目读取系统环境变量，不自动加载 .env）
# 换掉默认密钥，否则任何人都能伪造 token（HS256 要求至少 32 字节）
WP_SECRET_KEY=dev-only-secret-please-change-me-32bytes
WP_DEBUG=1
WP_TOKEN_HOURS=12

# 数据目录：默认依次尝试
#   algorithm/data/oulad/interim_demo
#   algorithm/data/oulad/interim
#   algorithm/data/interim
# 也可以显式指定
# WP_INTERIM=../algorithm/data/oulad/interim_demo

# 演示账号
WP_DEMO_PASSWORD=wp123456
WP_DEMO_ACCOUNTS=29

# 用户库（sqlite，仅存账号，不存业务数据）
# WP_DB_PATH=./data/app.db
