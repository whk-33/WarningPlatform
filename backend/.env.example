# 复制为 .env 后按需修改（本项目读取系统环境变量，不自动加载 .env）
# 换掉默认密钥，否则任何人都能伪造 token（HS256 要求至少 32 字节）
WP_SECRET_KEY=dev-only-secret-please-change-me-32bytes
WP_DEBUG=1
WP_TOKEN_HOURS=12

# 数据目录：默认依次尝试
#   algorithm/data/oulad/interim_demo
#   algorithm/data/oulad/interim
#   algorithm/data/interim
# 也可以显式指定
# WP_INTERIM=../algorithm/data/oulad/interim_demo

# 阶段四风险分：risk_scores.parquet 所在目录
# 不存在时自动退回 ../docs/mock_api/*.json（只有 top20 样本）
# WP_PROCESSED=../algorithm/data/oulad/processed_full_demo
# WP_MOCK_API=../docs/mock_api
# 精简图（5MB），优先于 graph_nx.json（100MB）
# WP_GRAPH=../algorithm/data/oulad/processed_full_demo/graph_api.json

# 演示账号
WP_DEMO_PASSWORD=wp123456
WP_DEMO_ACCOUNTS=29
# 风险演示账号名（学生端联调用，启动时自动绑到风险数据里曲线最完整的学生）
# WP_RISK_DEMO_ACCOUNT=riskdemo

# 用户库（sqlite，仅存账号，不存业务数据）
# WP_DB_PATH=./data/app.db
